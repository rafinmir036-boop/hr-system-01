<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HR Management System</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Firebase SDKs -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { getAuth, signInWithEmailAndPassword, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
    import { getFirestore, collection, addDoc, getDocs } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

    // Firebase Config Integrated
    const firebaseConfig = {
      apiKey: "AIzaSyB20hWCqKPSt2aZxVOYa3cz2FVX2MSCs1U",
      authDomain: "rafin-328ee.firebaseapp.com",
      projectId: "rafin-328ee",
      storageBucket: "rafin-328ee.firebasestorage.app",
      messagingSenderId: "393954293230",
      appId: "1:393954293230:web:03bb7b058a89c339410aff",
      measurementId: "G-0HN3Z0SJ3W"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);

    // Global Functions for Login & Logout
    window.loginUser = async function() {
      const email = document.getElementById('login-email').value;
      const pass = document.getElementById('login-password').value;
      const errBox = document.getElementById('login-error');
      try {
        await signInWithEmailAndPassword(auth, email, pass);
        errBox.classList.add('hidden');
      } catch (err) {
        errBox.innerText = "লগইন ব্যর্থ হয়েছে: " + err.message;
        errBox.classList.remove('hidden');
      }
    };

    window.logoutUser = function() {
      signOut(auth);
    };

    // Auth State Observer
    onAuthStateChanged(auth, (user) => {
      if (user) {
        document.getElementById('login-screen').classList.add('hidden');
        document.getElementById('app-screen').classList.remove('hidden');
        document.getElementById('user-email').innerText = user.email;
      } else {
        document.getElementById('login-screen').classList.remove('hidden');
        document.getElementById('app-screen').classList.add('hidden');
      }
    });
  </script>
</head>
<body class="bg-gray-100 font-sans antialiased">

  <!-- 🔐 Login View -->
  <div id="login-screen" class="min-h-screen flex items-center justify-center bg-slate-900 px-4">
    <div class="bg-white p-8 rounded-xl shadow-lg w-full max-w-md">
      <div class="text-center mb-6">
        <i class="fa-solid fa-users-gear text-blue-600 text-4xl mb-2"></i>
        <h2 class="text-2xl font-bold text-gray-800">HR System Login</h2>
      </div>
      <div id="login-error" class="hidden mb-4 p-3 bg-red-100 text-red-700 text-sm rounded-lg"></div>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700">Email Address</label>
          <input type="email" id="login-email" class="w-full mt-1 p-2.5 border rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="admin@test.com">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Password</label>
          <input type="password" id="login-password" class="w-full mt-1 p-2.5 border rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="••••••••">
        </div>
        <button onclick="loginUser()" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2.5 rounded-lg font-semibold transition">Sign In</button>
      </div>
    </div>
  </div>

  <!-- 📊 Main App View -->
  <div id="app-screen" class="hidden flex h-screen overflow-hidden">
    <!-- Sidebar -->
    <aside class="w-64 bg-slate-900 text-white flex flex-col justify-between">
      <div>
        <div class="p-5 text-xl font-bold border-b border-slate-800 flex items-center space-x-2">
          <i class="fa-solid fa-users-gear text-blue-500"></i>
          <span>HR System</span>
        </div>
        <nav class="mt-4 px-3 space-y-1 text-sm overflow-y-auto max-h-[calc(100vh-120px)]">
          <a href="#" onclick="showSection('dashboard')" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg hover:bg-slate-800 transition"><i class="fa-solid fa-chart-line w-5"></i><span>Dashboard</span></a>
          <a href="#" onclick="showSection('employees')" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg hover:bg-slate-800 transition"><i class="fa-solid fa-user-group w-5"></i><span>Employees</span></a>
          <a href="#" onclick="showSection('attendance')" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg hover:bg-slate-800 transition"><i class="fa-solid fa-clock w-5"></i><span>Attendance</span></a>
          <a href="#" onclick="showSection('leave')" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg hover:bg-slate-800 transition"><i class="fa-solid fa-file-pen w-5"></i><span>Leave Requests</span></a>
          <a href="#" onclick="showSection('payroll')" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg hover:bg-slate-800 transition"><i class="fa-solid fa-sack-dollar w-5"></i><span>Payroll</span></a>
          <a href="#" onclick="showSection('increment')" class="flex items-center space-x-3 px-3 py-2.5 rounded-lg hover:bg-slate-800 transition"><i class="fa-solid fa-chart-line-up w-5"></i><span>Increment</span></a>
        </nav>
      </div>
      <div class="p-4 border-t border-slate-800">
        <button onclick="logoutUser()" class="w-full bg-red-600 hover:bg-red-700 text-white py-2 rounded-lg text-sm transition flex items-center justify-center space-x-2">
          <i class="fa-solid fa-right-from-bracket"></i><span>Logout</span>
        </button>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col overflow-y-auto">
      <header class="bg-white shadow-sm border-b px-6 py-4 flex justify-between items-center">
        <h1 id="page-title" class="text-xl font-bold text-gray-800">Dashboard</h1>
        <div class="flex items-center space-x-3">
          <span id="user-email" class="text-sm font-medium text-gray-600"></span>
        </div>
      </header>

      <div class="p-6">
        <section id="sec-dashboard" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4">
            <div class="bg-white p-5 rounded-xl border shadow-sm"><p class="text-xs text-gray-500 font-bold uppercase">Total Employees</p><h3 class="text-2xl font-bold text-gray-800 mt-2">250</h3></div>
            <div class="bg-white p-5 rounded-xl border shadow-sm border-l-4 border-l-green-500"><p class="text-xs text-gray-500 font-bold uppercase">Present Today</p><h3 class="text-2xl font-bold text-green-600 mt-2">230</h3></div>
            <div class="bg-white p-5 rounded-xl border shadow-sm border-l-4 border-l-red-500"><p class="text-xs text-gray-500 font-bold uppercase">Absent Today</p><h3 class="text-2xl font-bold text-red-600 mt-2">12</h3></div>
            <div class="bg-white p-5 rounded-xl border shadow-sm border-l-4 border-l-yellow-500"><p class="text-xs text-gray-500 font-bold uppercase">On Leave</p><h3 class="text-2xl font-bold text-yellow-600 mt-2">8</h3></div>
            <div class="bg-white p-5 rounded-xl border shadow-sm border-l-4 border-l-purple-500"><p class="text-xs text-gray-500 font-bold uppercase">Increment Due</p><h3 class="text-2xl font-bold text-purple-600 mt-2">5</h3></div>
          </div>
        </section>

        <section id="sec-employees" class="hidden">
          <div class="bg-white p-6 rounded-xl border shadow-sm">
            <h2 class="text-lg font-bold text-gray-800 mb-2">Employee Directory</h2>
            <p class="text-gray-500 text-sm">Employee creation and list view interface.</p>
          </div>
        </section>

        <section id="sec-generic" class="hidden">
          <div class="bg-white p-6 rounded-xl border shadow-sm">
            <h2 id="generic-title" class="text-lg font-bold text-gray-800 mb-2">Module</h2>
            <p class="text-gray-500 text-sm">This module interface is ready for logic integration.</p>
          </div>
        </section>
      </div>
    </main>
  </div>

  <script>
    function showSection(sectionId) {
      ['dashboard', 'employees', 'generic'].forEach(id => {
        const el = document.getElementById('sec-' + id);
        if (el) el.classList.add('hidden');
      });
      document.getElementById('page-title').innerText = sectionId.charAt(0).toUpperCase() + sectionId.slice(1);
      const targetSec = document.getElementById('sec-' + sectionId);
      if (targetSec) {
        targetSec.classList.remove('hidden');
      } else {
        document.getElementById('generic-title').innerText = sectionId;
        document.getElementById('sec-generic').classList.remove('hidden');
      }
    }
  </script>
</body>
</html>
